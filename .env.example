# Server-side only (never exposed to the browser)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<your-key>

# Optional overrides — defaults come from broadcast/.../run-latest.json
# VITE_CONTRACT_ADDRESS=0x...
# VITE_CHAIN_ID=11155111
# VITE_DEPLOYMENT_BLOCK=
# VITE_EXPLORER_URL=https://sepolia.etherscan.io

# Vercel Blob — set automatically when a Blob store is connected to the project.
# Without it, project details are stored in ./.data (local dev only).
# BLOB_READ_WRITE_TOKEN=
# BLOB_ACCESS=public
